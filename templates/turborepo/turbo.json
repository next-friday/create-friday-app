{
  "$schema": "https://turborepo.dev/schema.json",
  "futureFlags": {
    "affectedUsingTaskInputs": true
  },
  "globalDependencies": [
    ".dockerignore",
    ".env",
    "package.json",
    "pnpm-workspace.yaml",
    "railway.json"
  ],
  "globalPassThroughEnv": [
    "APP_URL",
    "CI",
    "DATABASE_URL",
    "NEXT_TELEMETRY_DISABLED",
    "PAYLOAD_SECRET"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "depcruise": {
      "inputs": ["$TURBO_DEFAULT$", "!README.md"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "!README.md"]
    },
    "test:changed": {
      "cache": false
    },
    "test:coverage": {
      "inputs": ["$TURBO_DEFAULT$", "!README.md"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md"],
      "outputs": [".next/types/**", "next-env.d.ts"]
    }
  }
}
