{
  "name": "@next-friday/create-app",
  "version": "9.11.0",
  "description": "Create a Next Friday project from a template.",
  "keywords": [
    "create",
    "scaffold",
    "template",
    "next-friday"
  ],
  "homepage": "https://github.com/next-friday/next-friday-create-app#readme",
  "bugs": {
    "url": "https://github.com/next-friday/next-friday-create-app/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/next-friday/next-friday-create-app.git"
  },
  "license": "MIT",
  "author": "Next Friday",
  "sideEffects": true,
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "bin": {
    "next-friday-create-app": "./dist/main.mjs"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "audit": "pnpm audit",
    "bands:check": "node plugins/sdlc/source/scripts/check-bands.ts",
    "build": "tsdown",
    "changeset": "changeset",
    "changeset:status": "changeset status --since main",
    "changesets:check": "node scripts/check-changesets.ts",
    "check:publint": "publint",
    "clean": "rm -rf dist coverage *.tsbuildinfo .eslintcache node_modules/.cache",
    "dev": "tsdown --watch",
    "evals:run": "claude plugin eval plugins/sdlc/adapters/claude-code --scaffold --tag no-shell --allow-tools Write Edit",
    "evals:run:write": "claude plugin eval plugins/sdlc/adapters/claude-code --scaffold --tag needs-write --allow-tools Write Edit Bash",
    "format": "prettier --write --cache .",
    "format:check": "prettier --check --cache . && editorconfig-checker",
    "gates:check": "node scripts/check-agent-gates.ts",
    "knip": "knip",
    "lint": "eslint . --fix --cache --max-warnings=0 --no-inline-config",
    "lint:check": "eslint . --cache --max-warnings=0 --no-inline-config",
    "loop:measure": "node plugins/sdlc/source/scripts/measure-loop.ts",
    "prepack": "pnpm build",
    "plan:check": "node plugins/sdlc/source/scripts/check-plan.ts",
    "plugin:check": "node scripts/sync-plugin.ts --check",
    "plugin:sync": "node scripts/sync-plugin.ts",
    "prepare": "husky",
    "rules:check": "node scripts/sync-agent-rules.ts --check",
    "rules:sync": "node scripts/sync-agent-rules.ts",
    "sort-package-json": "sort-package-json package.json",
    "sort-package-json:check": "sort-package-json --check package.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "pnpm rules:check && pnpm plugin:check && pnpm gates:check && pnpm plan:check && pnpm bands:check && pnpm changesets:check && pnpm lint:check && pnpm format:check && pnpm sort-package-json:check && pnpm typecheck && pnpm test:coverage && pnpm knip && pnpm build && pnpm check:publint"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.4",
    "@next-friday/commitlint-config-friday": "4.0.0",
    "@next-friday/eslint-config-friday": "5.1.0",
    "@next-friday/prettier-config-friday": "4.0.0",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "editorconfig-checker": "7.0.0",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "knip": "6.44.1",
    "lint-staged": "17.6.0",
    "pkg-pr-new": "0.0.93",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "sort-package-json": "4.1.0",
    "tsdown": "0.23.5",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec",
  "engines": {
    "node": ">=24.15.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
