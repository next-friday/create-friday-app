{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["node"]
  },
  "include": ["eslint.config.ts", "prettier.config.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "apps"]
}
