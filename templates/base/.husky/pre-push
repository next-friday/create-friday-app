#!/usr/bin/env sh
set -e

# The first push of a new repository creates main on the remote, so it is the only push allowed there.
while read -r local_ref _ remote_ref remote_oid; do
  if [ "$remote_ref" = refs/heads/main ] && [ -n "$(printf '%s' "$remote_oid" | tr -d 0)" ]; then
    echo "pre-push: do not push to main. Push your branch and open a pull request." >&2
    exit 1
  fi
  # A branch this clone pushed before that the remote no longer has was deleted when its pull request merged or closed.
  branch="${remote_ref#refs/heads/}"
  if [ "$branch" != "$remote_ref" ] && [ -z "$(printf '%s' "$remote_oid" | tr -d 0)" ] \
    && { git rev-parse --verify --quiet "refs/remotes/$1/$branch" > /dev/null \
      || [ "$(git config "branch.${local_ref#refs/heads/}.merge" || true)" = "$remote_ref" ]; }; then
    echo "pre-push: $branch no longer exists on $1, so its pull request merged or closed. Branch from the latest $1/main, push the new branch, and open a new pull request." >&2
    exit 1
  fi
done

pnpm check || {
  echo "pre-push: pnpm check failed. Fix the failures above, commit, then push again." >&2
  exit 1
}
