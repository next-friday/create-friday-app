#!/usr/bin/env sh
set -e

if [ "$(git branch --show-current)" = main ]; then
  echo "pre-commit: do not commit on main. Create a branch: git switch --create <type>/<short-description>" >&2
  exit 1
fi

command -v gitleaks > /dev/null 2>&1 || {
  echo "pre-commit: gitleaks is required. Install it, then commit again." >&2
  exit 1
}

gitleaks git --pre-commit --redact --staged --no-banner --config .gitleaks.toml
pnpm exec lint-staged --config .lintstagedrc.json
