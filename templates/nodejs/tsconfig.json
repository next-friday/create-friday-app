{
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "isolatedModules": true,
    "removeComments": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": ".",
    "types": ["node"],
    "rewriteRelativeImportExtensions": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
