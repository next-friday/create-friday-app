{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "sh \"${CURSOR_PLUGIN_ROOT}/hooks/check-reply-shape.sh\" snapshot"
      }
    ],
    "afterAgentResponse": [
      {
        "command": "sh \"${CURSOR_PLUGIN_ROOT}/hooks/check-reply-shape.sh\" save"
      }
    ],
    "stop": [
      {
        "command": "sh \"${CURSOR_PLUGIN_ROOT}/hooks/check-reply-shape.sh\" followup",
        "loop_limit": 1
      }
    ],
    "sessionStart": [
      {
        "command": "sh \"${CURSOR_PLUGIN_ROOT}/hooks/sdlc-status.sh\" json"
      }
    ]
  }
}
