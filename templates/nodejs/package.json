{
  "name": "next-friday-template-nodejs",
  "version": "0.1.0",
  "private": true,
  "description": "Next Friday Node.js template.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/next-friday/next-friday-template-nodejs.git"
  },
  "license": "UNLICENSED",
  "author": "Next Friday",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm verify:static && pnpm test:changed && pnpm build",
    "clean": "rm -rf dist coverage *.tsbuildinfo .eslintcache node_modules/.cache",
    "depcruise": "depcruise --config .dependency-cruiser.json src eslint.config.ts vitest.config.ts",
    "format": "prettier --write --cache .",
    "format:check": "prettier --check --cache . && editorconfig-checker",
    "gates:check": "node scripts/check-agent-gates.ts",
    "knip": "knip",
    "lint": "eslint . --fix --cache --max-warnings=0 --no-inline-config",
    "lint:check": "eslint . --cache --max-warnings=0 --no-inline-config",
    "peers:check": "pnpm peers check",
    "prepare": "husky",
    "rules:check": "node scripts/sync-agent-rules.ts --check",
    "rules:sync": "node scripts/sync-agent-rules.ts",
    "sort-package-json": "sort-package-json package.json",
    "sort-package-json:check": "sort-package-json --check package.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "start:dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "start:prod": "node dist/main.js",
    "suppressions:check": "bash .agents/hooks/agent-suppression-gate.sh --repo",
    "test": "vitest run --passWithNoTests",
    "test:changed": "if git rev-parse --quiet --verify origin/main > /dev/null && git diff --quiet \"$(git merge-base origin/main HEAD)\" -- pnpm-lock.yaml pnpm-workspace.yaml \"*package.json\" \"*tsconfig.json\" .husky; then vitest run --changed origin/main --passWithNoTests; else vitest run --passWithNoTests; fi",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "pnpm verify:static && pnpm test:coverage && pnpm build",
    "verify:static": "pnpm suppressions:check && pnpm rules:check && pnpm gates:check && pnpm lint:check && pnpm format:check && pnpm sort-package-json:check && pnpm peers:check && pnpm typecheck && pnpm knip && pnpm depcruise"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@next-friday/commitlint-config-friday": "5.2.0",
    "@next-friday/eslint-config-friday": "5.2.0",
    "@next-friday/prettier-config-friday": "4.0.0",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "dependency-cruiser": "18.7.0",
    "editorconfig-checker": "7.0.0",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "knip": "6.43.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "sort-package-json": "4.1.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.17.0+sha512.b8d223ebec04b580a89ed206daa71d1bccb6a1ee1d52efa95cc3b0db75271561df8f0d8e2c43add39c5ec08018af7a8a95108e7090f95a29f88727b7a40fd53d",
  "engines": {
    "node": ">=24.15.0 <25"
  }
}
