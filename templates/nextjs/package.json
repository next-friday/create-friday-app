{
  "name": "next-friday-template-nextjs",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js application.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/next-friday/next-friday-template-nextjs.git"
  },
  "license": "UNLICENSED",
  "author": "Next Friday",
  "type": "module",
  "scripts": {
    "bands:check": "node scripts/check-bands.ts",
    "build": "next build",
    "check": "pnpm verify:static && pnpm test:changed && pnpm build",
    "clean": "rm -rf .next coverage *.tsbuildinfo .eslintcache node_modules/.cache",
    "depcruise": "depcruise --config .dependency-cruiser.json app test eslint.config.ts next.config.ts playwright.config.ts postcss.config.mjs vitest.config.ts",
    "dev": "next dev",
    "format": "prettier --write --cache .",
    "format:check": "prettier --check --cache . && editorconfig-checker",
    "gates:check": "node scripts/check-agent-gates.ts",
    "knip": "knip",
    "lint": "eslint . --fix --cache --max-warnings=0 --no-inline-config",
    "lint:check": "eslint . --cache --max-warnings=0 --no-inline-config",
    "loop:measure": "node scripts/measure-loop.ts",
    "plan:check": "node scripts/check-plan.ts",
    "prepare": "husky && next typegen",
    "rules:check": "node scripts/sync-agent-rules.ts --check",
    "rules:sync": "node scripts/sync-agent-rules.ts",
    "sort-package-json": "sort-package-json package.json",
    "sort-package-json:check": "sort-package-json --check package.json",
    "start": "cp -R .next/static .next/standalone/.next/ && (test ! -d public || cp -R public .next/standalone/) && node .next/standalone/server.js",
    "test": "vitest run --passWithNoTests",
    "test:changed": "if git rev-parse --quiet --verify origin/main > /dev/null && git diff --quiet \"$(git merge-base origin/main HEAD)\" -- pnpm-lock.yaml pnpm-workspace.yaml \"*package.json\" \"*tsconfig.json\" .husky; then vitest run --changed origin/main --passWithNoTests; else vitest run --passWithNoTests; fi",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.json",
    "verify": "pnpm verify:static && pnpm test:coverage && pnpm build",
    "verify:static": "pnpm rules:check && pnpm gates:check && pnpm plan:check && pnpm bands:check && pnpm lint:check && pnpm format:check && pnpm sort-package-json:check && pnpm typecheck && pnpm knip && pnpm depcruise"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@next-friday/commitlint-config-friday": "4.0.0",
    "@next-friday/eslint-config-friday": "5.1.0",
    "@next-friday/prettier-config-friday": "4.0.0",
    "@next/eslint-plugin-next": "16.4.5",
    "@playwright/test": "1.64.1",
    "@swc/core": "1.16.22",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "dependency-cruiser": "18.7.2",
    "editorconfig-checker": "7.0.0",
    "eslint": "10.14.0",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "knip": "6.44.1",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sort-package-json": "4.1.0",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec",
  "engines": {
    "node": ">=24.15.0 <25"
  }
}
