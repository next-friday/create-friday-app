{
  "name": "next-friday-template-turborepo",
  "version": "0.1.0",
  "private": true,
  "description": "Next Friday Turborepo template.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/next-friday/next-friday-template-turborepo.git"
  },
  "license": "UNLICENSED",
  "author": "Next Friday",
  "type": "module",
  "scripts": {
    "build": "turbo run build --filter=./apps/*",
    "check": "pnpm verify:static && pnpm test:changed",
    "clean": "rm -rf apps/app/.next apps/app/coverage apps/backoffice/.next apps/backoffice/coverage .turbo coverage *.tsbuildinfo .eslintcache node_modules/.cache",
    "depcruise": "turbo run depcruise --filter=./apps/*",
    "dev": "turbo run dev --filter=./apps/*",
    "format": "prettier --write --cache .",
    "format:check": "prettier --check --cache . && editorconfig-checker",
    "gates:check": "node scripts/check-agent-gates.ts",
    "generate:importmap": "pnpm --filter ./apps/backoffice generate:importmap",
    "generate:types": "pnpm --filter ./apps/backoffice generate:types",
    "knip": "knip",
    "lint": "eslint . --fix --cache --max-warnings=0 --no-inline-config",
    "lint:check": "eslint . --cache --max-warnings=0 --no-inline-config",
    "migrate": "pnpm --filter ./apps/backoffice migrate",
    "migrate:create": "pnpm --filter ./apps/backoffice migrate:create",
    "peers:check": "pnpm peers check",
    "prepare": "husky && pnpm --filter ./apps/app exec next typegen && pnpm --filter ./apps/backoffice exec next typegen",
    "rules:check": "node scripts/sync-agent-rules.ts --check",
    "rules:sync": "node scripts/sync-agent-rules.ts",
    "sort-package-json": "sort-package-json package.json apps/app/package.json apps/backoffice/package.json",
    "sort-package-json:check": "sort-package-json --check package.json apps/app/package.json apps/backoffice/package.json",
    "start": "turbo run start --filter=./apps/*",
    "suppressions:check": "bash .agents/hooks/agent-suppression-gate.sh --repo",
    "test": "turbo run test --filter=./apps/*",
    "test:changed": "turbo run test:changed --filter=./apps/*",
    "test:coverage": "turbo run test:coverage --filter=./apps/*",
    "test:e2e": "turbo run test:e2e --filter=./apps/*",
    "test:watch": "turbo run test:watch --filter=./apps/*",
    "typecheck": "tsc --noEmit -p tsconfig.json && turbo run typecheck --filter=./apps/*",
    "verify": "pnpm verify:static && pnpm test:coverage",
    "verify:static": "pnpm suppressions:check && pnpm rules:check && pnpm gates:check && pnpm lint:check && pnpm format:check && pnpm sort-package-json:check && pnpm peers:check && pnpm typecheck && pnpm knip && pnpm depcruise"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@next-friday/commitlint-config-friday": "4.0.0",
    "@next-friday/eslint-config-friday": "5.1.0",
    "@next-friday/prettier-config-friday": "4.0.0",
    "@next/eslint-plugin-next": "16.4.3",
    "@types/node": "26.6.5",
    "editorconfig-checker": "7.0.0",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "knip": "6.43.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sort-package-json": "4.1.0",
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec",
  "engines": {
    "node": ">=24.22.1 <25"
  }
}
